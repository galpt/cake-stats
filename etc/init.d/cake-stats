#!/bin/sh /etc/rc.common
# cake-stats - real-time CAKE SQM statistics web dashboard
# OpenWrt procd init script

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/cake-stats"
HOST="${CAKE_STATS_HOST:-0.0.0.0}"
PORT="${CAKE_STATS_PORT:-11112}"
INTERVAL="${CAKE_STATS_INTERVAL:-1s}"

start_service() {
	logger -t cake-stats "Registering procd instance on $HOST:$PORT (interval $INTERVAL)"

	procd_open_instance
	procd_set_param command /bin/sh -c '
		if [ ! -x "$1" ]; then
			logger -t cake-stats "binary $1 not found at startup, waiting"
			until [ -x "$1" ]; do
				sleep 1
			done
		fi
		logger -t cake-stats "Launching on $2:$3 (interval $4)"
		exec "$1" -host "$2" -port "$3" -interval "$4"
	' sh "$PROG" "$HOST" "$PORT" "$INTERVAL"
	procd_set_param pidfile /var/run/cake-stats.pid
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	logger -t cake-stats "Stopping"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "cake-stats"
}
